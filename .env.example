PORT=8787
# https://kie.ai/api-key
KIE_API_KEY=
# 腾讯云 COS，AI 改图前会把图片传到这里
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# 桶已公开读时填写，例如 https://bucket.cos.ap-guangzhou.myqcloud.com
# 留空则使用 6 小时有效的签名地址
COS_PUBLIC_BASE_URL=
# 页面和接口不在同一个域名时填写，逗号分隔。例如 https://sliesu.github.io
# APP_ORIGINS=
# 每个 IP 每小时 / 每天最多生成几次。不填时，正式环境 8 次/小时、24 次/天
# AI_HOURLY_LIMIT=
# AI_DAILY_LIMIT=
# 所有人加起来每小时最多生成几次。不填时正式环境 60
# AI_GLOBAL_HOURLY=
# 前面有反向代理、要按访客真实 IP 限流时设为 1
# TRUST_PROXY=
